{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "trailingComma": "es5",
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/out/**",
    "**/build/**",
    "**/coverage/**",
    "**/.turbo/**",
    ".pi/**",
    "bun.lock"
  ],
  "overrides": [
    {
      "files": ["apps/backend/**"],
      "options": { "singleQuote": true, "trailingComma": "all" }
    }
  ]
}
