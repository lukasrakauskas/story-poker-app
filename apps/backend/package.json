    "nanoid": "^6.0.1",
    "radash": "^12.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "shared": "workspace:*",
    "socket.io": "^4.8.3",
    "ws": "^8.21.3",
    "zod": "^4.6.1"
